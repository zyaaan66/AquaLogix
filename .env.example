# Copy this file to .env and fill in real values.
# IMPORTANT: use `.env`, not `.env.local` — Prisma CLI (db push, generate, etc.)
# only reads `.env` by default, while Next.js happily reads `.env` too, so a
# single `.env` file works for both. `.env` is already git-ignored — never
# commit real secrets.

# Gemini Flash API key — used ONLY server-side in src/app/api/ai/analyze/route.ts
GEMINI_API_KEY=

# Database (SQLite for dev; switch to a postgres:// URL + provider="postgresql" in prisma/schema.prisma for prod)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-another-long-random-value
